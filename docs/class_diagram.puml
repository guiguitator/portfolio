@startuml class_diagram

entity Message {
    id: int
    senderName: string
    senderEmail: string
    subject: string
    content: string
}

entity Project {
    id: int
    name: string
    caption: string
    githubUrl: ?string
    documentationUrl: ?string
    content: string
    featured: bool
    createdAt: DateTimeImmutable
    updatedAt: DateTimeImmutable
}

entity Tag {
    id: int
    name: string
}

entity User {
    id: int
    email: string
    password: string
    roles: string[]
}

Project "*" -- "*" Tag 

@enduml