<article class="project-card">

    {% if project.image is not null %}
        <div class="project-card-icon">
            <img src="{{ asset('uploads/projects/' ~ project.image) }}" alt="{{ project.name|default('Projet') }}" />
        </div>
    {% endif %}

    <div class="project-card-contents">
        <h3 class="project-card-name">
            {{ project.name }}
        </h3>
        <div class="project-card-tags">
            {% for tag in project.tags %}
                {% include 'partials/_tag.html.twig' %}
            {% endfor %}
        </div>
        <p class="project-card-caption">
            {{ project.caption }}
        </p>
    </div>
    <div class="project-card-actions">
        <a href="{{ path('app_project_details', {'id': project.id }) }}" class="btn btn-primary">Voir plus</a>

        <div class="project-card-links">
            {% if project.githubUrl is not null %}
                <a class="project-card-link" target="_blank" href="{{ project.githubUrl }}" rel="noopener noreferrer">
                    <i class="bi bi-github"></i>
                </a>
            {% endif %}

            {% if project.documentationUrl is not null %}
                <a class="project-card-link" target="_blank" href="{{ project.documentationUrl }}" rel="noopener noreferrer">
                    <i class="bi bi-book-fill"></i>
                </a>
            {% endif %}
        </div>
    </div>
    
</article>
