{% extends 'base.html.twig' %}

{% block title %}Projets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/projects.css') }}">
{% endblock %}

{% block body %}
    <section class="section-projects-header">
        <h1>Projets</h1>
        <div class="section-projects-header-content">
            <p>
                Sur cette page, vous retrouverez l'ensemble des projets et réalisations que j'ai 
                menés au cours de mes deux années de BTS SIO. Ces travaux illustrent les 
                compétences que j'ai développées dans différents domaines de l'informatique, aussi 
                bien en développement qu'en gestion de projets, à travers des expériences 
                concrètes réalisées en formation et en autonomie.
            </p>
            {% if current_tag is not empty %}
                <p>
                    Résultat(s) pour le tag : <strong>{{ current_tag }}</strong>
                </p>
            {% endif %}
        </div>
    </section>
    <section class="section-projects-list">
        <div class="project-card-wrapper">
            {% if projects|length === 0 %}
                <p>Aucun projet à afficher pour le moment.</p>
            {% else %}
                {% for project in projects %}
                    {% include 'partials/_project_card.html.twig' %}
                {% endfor %}
            {% endif %}
        </div>
    </section>
{% endblock %}
