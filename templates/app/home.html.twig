{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/home.css') }}">
{% endblock %}

{% block body %}
    <section id="hero">
        <div class="hero-image">
            <img src="{{ asset('images/portrait.png') }}" alt="Portrait de Meunier Guillaume" />
        </div>
        <div>
            <h1 class="hero-title">Meunier Guillaume</h1>
            <p>
                Étudiant en 2<sup>ème</sup> année de <b>BTS Service Informatique aux 
                Organisations</b>, option <b>Solutions Logicielles et Applications Métiers</b>.
            </p>
            <div class="hero-actions">
                <a href="{{ path('app_projects') }}" class="btn btn-primary">Voir les projets</a>
                <a href="{{ path('app_home') }}#contact" class="btn">Me contacter</a>
            </div>
        </div>
    </section>
    <section id="about-me">
        <h2>À propos de moi</h2>
        <p>
            Passionné de développement d'applications et de solutions logicielles, je suis 
            constamment à la recherche de nouveaux défis pour améliorer mes compétences et 
            concevoir des projets innovants. Mon parcours en BTS SIO m'a permis d'acquérir une 
            solide base en programmation, gestion de projet et travail en équipe, que je mets en 
            pratique à travers mes projets personnels et professionnels.
        </p>
    </section>
    <section id="projects">
        <h2>Projets séléctionnés</h2>
        <div class="project-card-wrapper">
            {% if featured_projects|length === 0 %}
                <p style="text-align: center;">Aucun projet à la une.</p>
            {% else %}
                {% for project in featured_projects %}
                    {% include 'partials/_project_card.html.twig' %}
                {% endfor %}
            {% endif %}
        </div>
    </section>
    <section id="contact">
        <h2>Contactez-moi</h2>

        {{ form(message_form) }}
        
        <div style="margin-top: 1rem;">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('danger') %}
                <div class="alert alert-error">
                    {{ message }}
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
